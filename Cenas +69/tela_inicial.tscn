[node name="Label3" type="Label" parent="tutorial_panel_03" unique_id=1402833797]
layout_mode = 0
offset_left = 101.0
offset_top = 393.0
offset_right = 1133.0
offset_bottom = 676.0
theme_override_colors/font_color = Color(0.43529412, 0.25490198, 0.16862746, 1)
theme_override_fonts/font = ExtResource("2_cwldp")
theme_override_font_sizes/font_size = 13
text = "O IDH basea-se em:
* Segurança: diminui a quantidade de crimes no seu país, aumentando a vida da população.
* Saúde: faz os cidadãos contribuírem por mais tempo, aumentando a arrecadação de impostos.
* Educação: melhora a especialização dos cidadãos, aumentando o valor pago de impostos e a criação de tecnologia em seu país.
O jogador pode escolher no que investir, e quanto mais alta as características maior o IDH.
O país do jogador pode ter cidadãos que não contribuem enconomicamente, como:
Criminosos: o jogador deve investir em segurança 
Aposentados e crianças: o jogador deve investir em educação, fazendo as pessoas trabalharem mais cedo e se aposentarem mais tarde."
horizontal_alignment = 1
autowrap_mode = 3

