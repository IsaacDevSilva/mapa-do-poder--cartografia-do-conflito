theme_override_font_sizes/font_size = 13
text = "Condições aleatórias, como:
Países aliados pedirem ajuda em conflitos( o jogador pode escolher ajudar ou não seu aliado, caso ajude ele entra no conflito, caso não ajude ele pede todo o respeito pelo país e sua honra é diminuída em 50 pontos.
Desastres naturais podem comprometer a produção de seu próprio país, como os de outros no mundo, caso isso ocorra as demandas do país vão aumentar e suas ofertas vão aumentar o valor."
horizontal_alignment = 1
autowrap_mode = 3

