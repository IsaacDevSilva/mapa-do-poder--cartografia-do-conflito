theme_override_font_sizes/font_size = 12
text = "O objetivo do jogo é ter um país com IDH maior que 0.9, ter um PIB maior que 20 Trilhões
e ser respeitado por mais de 3 países."
horizontal_alignment = 1

[node name="regras2" type="Label" parent="tutorial_panel_01" unique_id=777910181]
layout_mode = 0
offset_top = 280.0
offset_right = 1152.0
offset_bottom = 377.0
theme_override_colors/font_color = Color(0.7254902, 0.45882353, 0.33333334, 1)
theme_override_fonts/font = ExtResource("2_cwldp")
theme_override_font_sizes/font_size = 12
text = "Como começa a partida.
O jogador escolhe um país.
Certas características do país e do mundo são escolhidas aleatoriamente.
O jogador começa com 1 bilhão para ultilizar.
O país do jogador começa obrigatoriamente subdesenvolvido."
horizontal_alignment = 1

[node name="regras3" type="Label" parent="tutorial_panel_01" unique_id=1127850376]
layout_mode = 0
offset_top = 488.0
offset_right = 1152.0
offset_bottom = 625.0
theme_override_colors/font_color = Color(0.7254902, 0.45882353, 0.33333334, 1)
theme_override_fonts/font = ExtResource("2_cwldp")
theme_override_font_sizes/font_size = 12
text = "Um turno pode ser realizado a cada ano.
Ao final de cada ano as mudaças são mostradas.
O jogador pode realizar certas ações em 1 turno, como:
* Comprar
* Vender
* Sancionar 
* Propor aliança 
* Investir"
horizontal_alignment = 1

