[node name="Label2" type="Label" parent="tutorial_panel_03" unique_id=1060800545]
layout_mode = 0
offset_left = 142.0
offset_top = 165.0
offset_right = 1012.0
offset_bottom = 360.0
theme_override_colors/font_color = Color(0.7254902, 0.45882353, 0.33333334, 1)
theme_override_fonts/font = ExtResource("2_cwldp")
theme_override_font_sizes/font_size = 13
text = "O jogador começa com 200 pontos de honra.
O jogador aumenta sua honra melhorando seu país.
A escala de honra vai de 0 a 1.000 pontos.
A honra serve para países escolherem suas ofertas e fazerem ofertas melhores para o jogador.
Quanto mais honra um país tiver mais confiável ele se torna.
Além da honra do país, o jogador tem um status único de relacionamento com cada país, chamada de respeito, ela aumenta quando o país de relacionamento positivamente."
horizontal_alignment = 1
autowrap_mode = 3

